{
  "plugins": {
    "allow": ["rebate-router", "openclaw-weixin"],
    "entries": {
      "rebate-router": {
        "enabled": true,
        "config": {
          "apiBaseUrl": "http://127.0.0.1:8765",
          "apiToken": "change-me-to-a-long-random-token",
          "passiveMode": true
        },
        "hooks": {
          "allowConversationAccess": true
        }
      },
      "openclaw-weixin": {
        "enabled": true
      }
    }
  }
}
